{
  "db_clients": [
    {
      "name": "db",
      "rdbms": "postgresql",
      "host": "127.0.0.1",
      "port": 5432,
      "dbname": "cardgame_db",
      "user": "cardgame_user",
      "passwd": "CHANGE_ME",
      "is_fast": false,
      "number_of_connections": 4
    }
  ],
  "app": {
    "number_of_threads": 2,
    "enable_session": true,
    "session_timeout": 3600,
    "session_same_site": "Lax",
    "document_root": "/opt/card-game/frontend",
    "home_page": "index.html",
    "idle_connection_timeout": 3600,
    "client_max_body_size": "1M",
    "client_max_memory_body_size": "64K",
    "client_max_websocket_message_size": "16K",
    "use_gzip": true,
    "log": {
      "log_level": "WARN",
      "log_size_limit": 10485760,
      "max_files": 5,
      "display_local_time": true
    }
  },
  "plugins": [
    {
      "name": "drogon::plugin::PromExporter",
      "dependencies": [],
      "config": {
        "path": "/metrics",
        "collectors": [
          {
            "name": "battle_websocket_messages_total",
            "help": "Total battle WebSocket messages sent",
            "type": "counter",
            "labels": []
          },
          {
            "name": "battle_websocket_payload_bytes_total",
            "help": "Total battle WebSocket payload bytes sent",
            "type": "counter",
            "labels": []
          }
        ]
      }
    },
    {
      "name": "drogon::plugin::AccessLogger",
      "dependencies": [],
      "config": {
        "use_spdlog": false,
        "log_path": "/var/log/card-game",
        "log_format": "$request_date $method $request_path $status_code $processing_time",
        "log_file": "access.log",
        "log_size_limit": 10485760,
        "use_local_time": true,
        "log_index": 0,
        "show_microseconds": false
      }
    }
  ],
  "custom_config": {}
}
